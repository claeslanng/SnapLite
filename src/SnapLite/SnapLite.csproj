<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SnapLite</RootNamespace>
    <AssemblyName>SnapLite</AssemblyName>
    <Version>1.0.1</Version>
    <!-- The logo for Explorer, the Start menu, the taskbar and Settings › Apps (regenerate it with the write-icon switch, see DocShots.cs). -->
    <ApplicationIcon>Assets\SnapLite.ico</ApplicationIcon>

    <!-- Per-monitor DPI awareness (emitted into ApplicationConfiguration.Initialize). -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Lean runtime: no background GC thread, workstation GC, English resources only. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>

  <!-- The WebView2 package also references its WPF control; this is a WinForms app, so drop it
       (avoids a WindowsBase version conflict and keeps the WPF dll out of the output). -->
  <Target Name="SnapLiteDropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <!-- Page scripts live in /shared-scripts so the Chrome extension can use the exact same files. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\shared-scripts\*.js" LogicalName="SnapLite.Scripts.%(Filename)%(Extension)" />
    <!-- The browser extension; Settings → Browser writes it to %LOCALAPPDATA%\SnapLite\browser-extension
         (adding the shared scripts and icons). -->
    <EmbeddedResource Include="..\..\extension\**\*" LogicalName="SnapLite.Extension/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SnapLite.Core\SnapLite.Core.csproj" />
  </ItemGroup>

</Project>
