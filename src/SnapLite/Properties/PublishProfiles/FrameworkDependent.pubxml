<?xml version="1.0" encoding="utf-8"?>
<!--
  Small single SnapLite.exe. Needs the .NET 10 Desktop Runtime (x64) on the PC.
  dotnet publish src/SnapLite -p:PublishProfile=FrameworkDependent
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WebView2Loader.dll goes inside the exe (unpacked once on first web capture). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Precompiled code: faster startup, a bit bigger exe. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <!-- Just the exe: no .pdb / .xml files from references next to it. -->
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\framework-dependent\</PublishDir>
  </PropertyGroup>
</Project>
