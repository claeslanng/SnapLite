<?xml version="1.0" encoding="utf-8"?>
<!--
  Single SnapLite.exe that runs on any 64-bit Windows 10/11 PC, no .NET install needed (bigger file).
  dotnet publish src/SnapLite -p:PublishProfile=SelfContained
  (Trimming isn't supported for WinForms, so the whole runtime is included.)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Not compressed on purpose: compression makes the exe ~51 MB instead of ~117 MB, but every run then
         unpacks the runtime into RAM (~79 MB private memory instead of ~18 MB). -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <!-- Just the exe: no .pdb / .xml files from references next to it. -->
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\self-contained\</PublishDir>
  </PropertyGroup>
</Project>
